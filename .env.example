# Generate each secret independently, for example: openssl rand -hex 64
SECRET_KEY_BASE=replace-with-a-long-random-value
VOICE_SERVICE_TOKEN=replace-with-a-different-random-value
DATABASE_NAME=ai_dream_production
DATABASE_USER=ai_dream
DATABASE_PASSWORD=replace-with-a-separate-random-value

# External HTTP port. Put TLS in a reverse proxy/load balancer in production.
APP_PORT=8088
FORCE_SSL=false

# Choose "ollama" (local) or "fireworks" (hosted API).
LLM_PROVIDER=ollama

# Self-hosted language model served by Ollama.
OLLAMA_MODEL=qwen2.5:3b

# Required only when LLM_PROVIDER=fireworks. Keep the key private.
FIREWORKS_API_KEY=
FIREWORKS_MODEL=accounts/fireworks/models/glm-5p3-flash

# CPU works but is slower. The GPU compose overlay changes this to cuda:0.
VOICE_DEVICE=cpu

# For reproducible production builds, replace main with audited commit SHAs.
OPENVOICE_REF=main
MELOTTS_REF=main
